{
  "name": "vacation-tracker",
  "version": "1.0.0",
  "description": "CLI application to track vacation days using Clockify API data",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci"
  },
  "author": "Xavier Balloy",
  "license": "MIT",
  "packageManager": "pnpm@12.22.0",
  "dependencies": {
    "dotenv": "18.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@kjanat/actionlint": "1.17.1",
    "@tsconfig/node26": "26.0.2",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
